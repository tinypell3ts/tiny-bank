{
  "uid": "tiny-bank-transaction",
  "title": "tiny-bank / Transactions",
  "description": "Whether transfers get finished: calls to the ledger by outcome and by who tried, and what's still pending, from the transaction service's business metrics (services/transaction/metrics.go); and whether its events reach Kafka, from its outbox (pkg/outbox).",
  "tags": [
    "tiny-bank"
  ],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pending transfers",
      "description": "Saved but not yet completed or failed. A few for a moment is normal; a number that keeps growing means the ledger isn't answering. Every pod reports the same count, so this is the max.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(transaction_pending_transfers)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest pending",
      "description": "How long the oldest pending transfer has waited. Over a minute means the finisher's retries aren't getting through.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(transaction_oldest_pending_seconds)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ledger posts per second",
      "description": "Every call to the ledger, from requests and from the finisher.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(transaction_ledger_posts_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ledger posts by outcome",
      "description": "posted: money moved. refused: the ledger said no (the transfer failed). unsure: a timeout or 5xx, so it's retried with the same key. key_reused: a bug, see the logs.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(transaction_ledger_posts_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ledger posts by who tried",
      "description": "request: within the caller's request. finisher: in the background, for what requests left pending. Finisher posts rising means the ledger is slow or down.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (by) (rate(transaction_ledger_posts_total[$__rate_interval]))",
          "legendFormat": "{{by}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Refusals by reason",
      "description": "Why the ledger refused transfers: the failure_reason saved on each failed transfer.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(transaction_ledger_posts_total{outcome=\"refused\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pending transfers over time",
      "description": "Should fall back to 0 once the ledger answers again. The Oldest pending stat above says how long the longest has waited.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(transaction_pending_transfers)",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Events waiting to send",
      "description": "Events the transaction service has saved in its outbox but not yet sent to Kafka. A few for a moment is normal; a number that keeps growing means Kafka isn't taking them. Counted up to 10,000. Every pod reports the same count, so this is the max.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(outbox_waiting_events{job=\"transaction\"})"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Oldest waiting event",
      "description": "How long the oldest unsent event has waited. Events normally go within a second; over a few seconds means Kafka is down or refusing them (the relay's log lines say why).",
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(outbox_oldest_waiting_seconds{job=\"transaction\"})"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Events sent per second",
      "description": "TransferChanged events sent to Kafka: about two per transfer (created, then completed or failed).",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(outbox_sent_events_total{job=\"transaction\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Outbox over time",
      "description": "Events waiting (left axis) against events sent per second (right axis). While Kafka is down, waiting grows and sent drops to 0; once it's back, waiting drains to 0 and sent jumps as the backlog goes out.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sent per second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(outbox_waiting_events{job=\"transaction\"})",
          "legendFormat": "waiting"
        },
        {
          "refId": "B",
          "expr": "sum(rate(outbox_sent_events_total{job=\"transaction\"}[$__rate_interval]))",
          "legendFormat": "sent per second"
        }
      ]
    }
  ]
}
