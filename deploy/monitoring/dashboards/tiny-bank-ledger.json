{
  "uid": "tiny-bank-ledger",
  "title": "tiny-bank / Ledger",
  "description": "What happens to money: journals posted, retried, refused and failed, and how much money moves, from the ledger's business metrics (services/ledger/metrics.go). Amounts are in each currency's minor unit (pence for GBP).",
  "tags": [
    "tiny-bank"
  ],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Journals posted per second",
      "description": "New journals only: retries and refusals move no money.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ledger_journals_total{outcome=\"posted\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Refused",
      "description": "Share of posts refused because the request broke a rule (a 4xx). A jump usually means a caller is sending bad requests.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ledger_journals_total{outcome=\"refused\"}[$__rate_interval])) / sum(rate(ledger_journals_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed",
      "description": "Share of posts that failed on our side (a 5xx), such as the account service being unreachable. Should be zero.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ledger_journals_total{outcome=\"failed\"}[$__rate_interval])) / sum(rate(ledger_journals_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Posts by outcome",
      "description": "posted: money moved. retried: the same idempotency key again, so the first journal came back and nothing moved. refused: a 4xx. failed: a 5xx.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(ledger_journals_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Refusals by reason",
      "description": "The terror code each refused post got, such as precondition_failed.insufficient_funds.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(ledger_journals_total{outcome=\"refused\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Money moved in this time range",
      "description": "The value of new journals in the time range you've picked, by currency, in minor units (pence for GBP, yen for JPY). It's volume: each journal's positive entries, so a £3 transfer counts 300. Net movement is always zero, because every journal adds up to zero. Prometheus estimates increases from its samples, so this is rounded.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (currency) (increase(ledger_moved_minor_units_total[$__range])))",
          "legendFormat": "{{currency}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Money moved, by currency",
      "description": "The value of new journals in each interval of the chart, in minor units (pence for GBP). Volume, not net: each journal's positive entries, so a £3 transfer counts 300. Retries and refusals move nothing, so they add nothing.",
      "gridPos": {
        "x": 6,
        "y": 12,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (currency) (increase(ledger_moved_minor_units_total[$__rate_interval])))",
          "legendFormat": "{{currency}}"
        }
      ]
    }
  ]
}
