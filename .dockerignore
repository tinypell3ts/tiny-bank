# Keep the build context small and the layer cache stable: only Go source is needed.
.git
.github
.claude
docs
scripts
# Helm values, dashboards and the kind config: editing a dashboard must not
# rebuild and restart every service (which also resets their metrics).
deploy
# Developer tools, like the journal load generator: not part of any service.
tools
# make proto-check's scratch copy of the generated code.
build
bin
dist
*.md
.env
.env.*
coverage.*
*.out
*.test
